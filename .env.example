# Local / documentation only. Never commit real values.
# Production injects secrets from AWS Secrets Manager via the ECS task
# definition — see deploy/ecs/web-task-definition.json and docs/authentication.md.

DJANGO_SETTINGS_MODULE=config.settings
SECRET_KEY=change-me-locally
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# --- AWS Cognito ---------------------------------------------------------
# Leave blank for local development: Cognito sign-in is then unavailable and
# only the bootstrap account can sign in. With DEBUG=False these are required
# and the application refuses to start without them.
AWS_REGION=ap-southeast-2
COGNITO_REGION=ap-southeast-2
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_DOMAIN=auth.dncouncil.org
COGNITO_REDIRECT_URI=http://localhost:8000/auth/callback/
COGNITO_LOGOUT_REDIRECT_URI=http://localhost:8000/login/

# Cognito groups that map to Scrapos roles.
COGNITO_GROUP_ADMIN=SCRAPOS_ADMIN
COGNITO_GROUP_EDITOR=SCRAPOS_EDITOR
COGNITO_GROUP_VIEWER=SCRAPOS_VIEWER

# --- Bootstrap superadmin (NOT a Cognito user) ---------------------------
# Emergency and first-run access. Only ever a Django password hash — there is
# no setting that accepts a plaintext password.
# Generate one with:  python manage.py hash_bootstrap_password --generate
SCRAPOS_BOOTSTRAP_ADMIN_ENABLED=True
SCRAPOS_SUPERADMIN_USERNAME=superadmin
SCRAPOS_SUPERADMIN_PASSWORD_HASH=

# --- Login throttling ----------------------------------------------------
SCRAPOS_LOGIN_THROTTLE_MAX_PER_USER=5
SCRAPOS_LOGIN_THROTTLE_MAX_PER_IP=20
SCRAPOS_LOGIN_THROTTLE_WINDOW_MINUTES=15
