{
  "_comment": [
    "Template for the Scrapos web task definition. Rendered by",
    "deploy/scripts/register-task-definition.sh.",
    "",
    "Matches outvier-ecs-cluster-production conventions:",
    "  - EC2 launch type with bridge networking",
    "  - hostPort 0 for dynamic ALB target registration",
    "  - memoryReservation only (no task-level cpu/memory)",
    "  - arm64 image for t4g.medium hosts",
    "",
    "No Celery worker, no MySQL, no Redis.",
    "",
    "Secrets come from two Secrets Manager entries, both readable by the",
    "shared execution role (secret:outvier-*):",
    "  outvier-scrapos-django-production  SECRET_KEY + bootstrap admin",
    "  outvier-scrapos-cognito-production  Cognito app client (Terraform-owned)",
    "",
    "The bootstrap superadmin is NOT a Cognito user. Its password reaches the",
    "container only as a Django hash; rotation is a secret update plus a",
    "redeploy, never a code change. See docs/authentication.md."
  ],
  "family": "__WEB_FAMILY__",
  "networkMode": "bridge",
  "requiresCompatibilities": ["EC2"],
  "taskRoleArn": "__TASK_ROLE_ARN__",
  "executionRoleArn": "__EXECUTION_ROLE_ARN__",
  "containerDefinitions": [
    {
      "name": "scrapos",
      "image": "__IMAGE__",
      "essential": true,
      "memoryReservation": __WEB_MEMORY_RESERVATION__,
      "portMappings": [
        {
          "containerPort": 8000,
          "hostPort": 0,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "DJANGO_SETTINGS_MODULE", "value": "config.settings" },
        { "name": "SERVICE_NAME", "value": "scrapos" },
        { "name": "DEBUG", "value": "False" },
        { "name": "ALLOWED_HOSTS", "value": "__PRODUCTION_DOMAIN__" },
        { "name": "CSRF_TRUSTED_ORIGINS", "value": "https://__PRODUCTION_DOMAIN__" },
        { "name": "DB_ENGINE", "value": "django.db.backends.sqlite3" },
        { "name": "DB_NAME", "value": "/tmp/scrapos.sqlite3" },
        { "name": "GUNICORN_WORKERS", "value": "2" },
        { "name": "GUNICORN_TIMEOUT", "value": "60" },
        { "name": "AWS_DEFAULT_REGION", "value": "__AWS_REGION__" },
        { "name": "COGNITO_REGION", "value": "__AWS_REGION__" },
        { "name": "COGNITO_USER_POOL_ID", "value": "__COGNITO_USER_POOL_ID__" },
        { "name": "COGNITO_DOMAIN", "value": "__COGNITO_DOMAIN__" },
        { "name": "COGNITO_REDIRECT_URI", "value": "https://__PRODUCTION_DOMAIN__/auth/callback/" },
        { "name": "COGNITO_LOGOUT_REDIRECT_URI", "value": "https://__PRODUCTION_DOMAIN__/login/" },
        { "name": "COGNITO_GROUP_ADMIN", "value": "SCRAPOS_ADMIN" },
        { "name": "COGNITO_GROUP_EDITOR", "value": "SCRAPOS_EDITOR" },
        { "name": "COGNITO_GROUP_VIEWER", "value": "SCRAPOS_VIEWER" },
        { "name": "SCRAPOS_BOOTSTRAP_ADMIN_ENABLED", "value": "__BOOTSTRAP_ADMIN_ENABLED__" }
      ],
      "secrets": [
        {
          "name": "SECRET_KEY",
          "valueFrom": "__DJANGO_SECRET_ARN__:secret_key::"
        },
        {
          "name": "COGNITO_CLIENT_ID",
          "valueFrom": "__COGNITO_SECRET_ARN__:client_id::"
        },
        {
          "name": "COGNITO_CLIENT_SECRET",
          "valueFrom": "__COGNITO_SECRET_ARN__:client_secret::"
        },
        {
          "name": "SCRAPOS_SUPERADMIN_USERNAME",
          "valueFrom": "__DJANGO_SECRET_ARN__:bootstrap_admin_username::"
        },
        {
          "name": "SCRAPOS_SUPERADMIN_PASSWORD_HASH",
          "valueFrom": "__DJANGO_SECRET_ARN__:bootstrap_admin_password_hash::"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl --fail --silent http://127.0.0.1:8000/healthz || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 30
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "__WEB_LOG_GROUP__",
          "awslogs-region": "__AWS_REGION__",
          "awslogs-stream-prefix": "web"
        }
      }
    }
  ]
}
